{
  "name": "shatsu-ren-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "test:db": "vitest run --dir db",
    "test:e2e": "vitest run --dir e2e --no-file-parallelism",
    "test": "echo 'use test:db / test:e2e (requires local supabase / browsers)'"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "playwright": "^1.63.0",
    "shatsu-ren-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
